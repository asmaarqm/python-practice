
import tkinter as tk

def add_numbers():
    try:
        num1 = float(entry1.get())
        num2 = float(entry2.get())
        result_label.config(text=f"Result: {num1 + num2}")
    except ValueError:
        result_label.config(text="Invalid input. Please enter numbers.")

def clear_field():
    entry1.delete(0, tk.END)
    entry2.delete(0, tk.END)
    result_label.config(text="Result displayed here")

root = tk.Tk()
root.title("Simple Adder")

# Row 0: Label & Input for Number 1
tk.Label(root, text="Number 1:").grid(row=0, column=0, padx=5, pady=5)
entry1 = tk.Entry(root, width=10)
entry1.grid(row=0, column=1, padx=5, pady=5)

# Row 1: Label & Input for Number 2
tk.Label(root, text="Number 2:").grid(row=1, column=0, padx=5, pady=5)
entry2 = tk.Entry(root, width=10)
entry2.grid(row=1, column=1, padx=5, pady=5)

# Row 2: Add & Clear Buttons
add_button = tk.Button(root, text="Add", command=add_numbers)
add_button.grid(row=2, column=0, padx=5, pady=5)

clear_button = tk.Button(root, text="Clear", command=clear_field)
clear_button.grid(row=2, column=1, padx=5, pady=5)

# Row 3: Result Display Label
result_label = tk.Label(root, text="Result displayed here")
result_label.grid(row=3, column=0, columnspan=2, padx=5, pady=5)

# Force window visibility on macOS
root.lift()
root.attributes('-topmost', True)
root.after_idle(root.attributes, '-topmost', False)

root.mainloop()
