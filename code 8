matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

symmetric_matrix = True

for i in range(len(matrix)):
    for j in range(len(matrix)):
        if matrix[i][j] != matrix[j][i]:
            symmetric_matrix = False
            break
    if not symmetric_matrix:
        break

if symmetric_matrix:
    print("symmetric")
else:
    print("not symmetric")